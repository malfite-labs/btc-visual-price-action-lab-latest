{
  "schema_version": "1.0.0",
  "strategy_id": "D_15M_BOTTOM_REVERSAL",
  "name_zh": "D策略：15分钟急跌后底部反转",
  "as_of": "2026-11-05",
  "status": "research_specification_unbacktested",
  "format": "custom_specification_not_platform_import_or_executable_code",
  "specification_file": "D策略_完整说明.md",
  "live_enabled": false,
  "scope": {
    "market": "crypto_perpetual",
    "contract_type": "USDT_linear",
    "exchange": null,
    "exchange_required_before_live": true,
    "symbols_research": ["BTCUSDT", "ETHUSDT"],
    "direction": "long_only",
    "margin_mode": "isolated",
    "max_leverage": 2,
    "auto_add_margin": false,
    "signal_timeframe": "15m",
    "context_timeframe": "1h",
    "data_timezone": "UTC",
    "report_timezone": "Asia/Shanghai"
  },
  "data": {
    "ohlcv_source": "same_exchange_perpetual_trade_prices",
    "volume_unit": "base_asset",
    "required_auxiliary": ["mark_prices", "funding_rates_and_settlement_times", "contract_filters", "bid_ask_quotes"],
    "execution_preferred": "1m_or_tick",
    "warmup_bars_15m": 960,
    "warmup_bars_1h": 240,
    "closed_bars_only": true,
    "one_hour_alignment": "latest_fully_closed_UTC_hour",
    "invalid_data_action": "block_new_entries_keep_protection_require_contiguous_rewarmup",
    "invalid_conditions": ["missing", "duplicate", "out_of_order", "invalid_ohlc", "volume_nonpositive", "nonfinite_indicator"],
    "range_notation": "inclusive_start_and_end"
  },
  "indicators": {
    "ema_periods_15m": [9, 20],
    "ema_periods_1h": [20, 50],
    "ema_seed": "SMA_first_n_closes_then_alpha_2_over_n_plus_1",
    "atr_period": 14,
    "atr_method": "Wilder_RMA_seed_mean_first_14_true_ranges",
    "rsi_period": 14,
    "rsi_method": "Wilder_RMA",
    "rsi_zero_loss_value": 100,
    "rsi_both_zero_value": 50,
    "rvol_lookback": 20,
    "rvol_definition": "V[t]/median(V[t-20:t-1])",
    "clv_definition": "(C-L)/(H-L)",
    "lower_wick_definition": "(min(O,C)-L)/(H-L)",
    "zero_range_action": "reject_candidate_or_confirmation"
  },
  "state_machine": {
    "states": ["IDLE", "WATCH", "PENDING", "LONG", "COOLDOWN"],
    "priority": ["position_risk_and_exits", "cooldown", "candidate_invalidation", "confirmation", "new_candidate"],
    "same_bar_create_and_confirm": false,
    "same_bar_recreate_after_invalidation": false,
    "replace_active_candidate": false,
    "max_entries_per_candidate": 1,
    "max_positions_per_symbol": 1,
    "pyramiding": false,
    "averaging_down": false,
    "simultaneous_symbol_priority": ["BTCUSDT", "ETHUSDT"],
    "cooldown_after_cancel_bars": 4,
    "cooldown_after_exit_bars": 8,
    "cooldown_count": "subsequent_full_15m_bars"
  },
  "candidate": {
    "evaluation": "at_k_close_only_when_IDLE",
    "all_conditions": [
      "C[k-1]<EMA20[k-1]",
      "EMA20[k-1]<EMA20[k-5]",
      "A=ATR14[k-1]>0",
      "(max(H[k-12:k-1])-L[k])/A>=2.5",
      "L[k]<min(L[k-8:k-1])",
      "C[k]>O[k] OR lower_wick_ratio[k]>=0.35",
      "CLV[k]>=0.55",
      "RVOL[k]>=1.3"
    ],
    "frozen_values": {"A": "ATR14[k-1]", "L0": "L[k]", "N": "max(H[k-3:k-1])", "S_raw": "L0-0.25*A"},
    "decline_lookback": 12,
    "decline_atr_min": 2.5,
    "new_low_lookback": 8,
    "lower_wick_ratio_min": 0.35,
    "clv_min": 0.55,
    "rvol_min": 1.3,
    "neckline_lookback": 3,
    "stop_buffer_atr": 0.25,
    "invalidation": "L[t]<L0-0.10*A",
    "invalidation_buffer_atr": 0.1,
    "confirmation_first_offset": 1,
    "confirmation_last_offset": 6,
    "expiry_order": "at_k_plus_6_invalidate_then_attempt_confirm_then_expire"
  },
  "confirmation": {
    "all_conditions": [
      "C[t]>N+0.05*A",
      "C[t]>EMA9[t]",
      "C[t]>O[t]",
      "CLV[t]>=0.65",
      "RVOL[t]>=1.2",
      "RSI14[t]>RSI14[t-1] AND RSI14[t]>=35",
      "0<C[t]-L0<=3.5*A",
      "NOT(C1h[h]<EMA50_1h[h] AND EMA20_1h[h]<EMA20_1h[h-3])",
      "0.6*A<=C[t]-S<=3.0*A",
      "ATR14_1h[h]/C1h[h]<=0.04"
    ],
    "breakout_buffer_atr": 0.05,
    "clv_min": 0.65,
    "rvol_min": 1.2,
    "rsi_min": 35,
    "max_distance_from_low_atr": 3.5,
    "max_hourly_atr_fraction": 0.04,
    "signal": "D_CONFIRM"
  },
  "entry": {
    "timing": "next_15m_bar_open_once",
    "order_type": "market",
    "reference_price_G": "O[t+1]_backtest_or_executable_ask_live",
    "modeled_fill_E": "G*(1+slippage_fraction)",
    "max_abs_gap_atr": 0.3,
    "all_conditions": ["abs(G-C[t])<=0.30*A", "G>N", "G>S", "0<E-L0<=3.5*A", "0.6*A<=E-S<=3.0*A", "(E-S)/E<=0.02", "spread_fraction<=0.0005", "all_portfolio_margin_liquidation_and_contract_filters_pass"],
    "min_stop_distance_atr": 0.6,
    "max_stop_distance_atr": 3.0,
    "max_stop_distance_fraction": 0.02,
    "max_spread_fraction": 0.0005,
    "missing_quote_live": "reject",
    "missing_quote_research": "disclose_execution_unverified",
    "failed_gate_action": "cancel_and_cooldown_no_delayed_entry",
    "after_fill": "recompute_actual_risk_reduce_if_excess_exit_and_pause_if_protection_fails"
  },
  "exits": {
    "R_definition": "actual_entry_E_minus_tick_rounded_initial_S",
    "initial_stop": "floor_to_tick(L0-0.25*A)",
    "stop_trigger": "last_trade_price",
    "liquidation_monitor": "independent_mark_price",
    "reduce_only": true,
    "take_profits": [{"r_multiple": 1.0, "fraction_initial_quantity": 0.5}, {"r_multiple": 2.0, "fraction_initial_quantity": 0.5}],
    "take_profit_rounding": "ceil_to_tick",
    "take_profit_execution": "trigger_then_market_with_sell_slippage_and_taker_fee",
    "after_tp1_stop": "max(previous_stop,E)_effective_next_15m_bar",
    "breakeven_is_price_only_not_fee_adjusted": true,
    "no_tp1_time_stop_bars": 8,
    "max_holding_bars": 16,
    "entry_bar_counts_as": 1,
    "time_exit": "next_open_after_counted_bar_closes",
    "time_exit_priority": "gap_stop_first_then_scheduled_exit_before_new_signals",
    "stop_gap_fill": "min(stop,bar_open)*(1-slippage_fraction)",
    "same_bar_stop_and_target": "stop_first_if_no_lower_timeframe_path",
    "same_bar_both_targets_only": "tp1_then_tp2",
    "illegal_split_quantity": "reject_before_entry"
  },
  "costs": {
    "status": "illustrative_replace_with_actual_account_and_execution_data",
    "taker_fee_fraction_per_side": 0.0005,
    "slippage_fraction_per_side": 0.0003,
    "funding_risk_reserve_fraction": 0.0005,
    "funding_pnl": "-remaining_base_quantity*settlement_mark_price*actual_funding_rate",
    "funding_schedule": "actual_exchange_settlement_timestamps_not_fixed_8h",
    "future_realized_funding_in_entry_features": false
  },
  "risk": {
    "risk_fraction_per_trade": 0.0025,
    "unit_loss": "E-S*(1-s)+f*(E+S*(1-s))+b*E",
    "quantity": "floor_to_lot(min(equity*0.0025/unit_loss,equity*0.50/E,previous_closed_bar_base_volume*0.005,margin_available_quantity))",
    "max_symbol_notional_fraction": 0.5,
    "max_portfolio_notional_fraction": 1.0,
    "max_order_previous_bar_volume_fraction": 0.005,
    "max_positions": 2,
    "max_portfolio_open_risk_fraction": 0.005,
    "open_risk_definition": "sum_remaining_qty_times_max(entry-current_stop,0)_plus_exit_cost_and_funding_reserve",
    "liquidation_price_source": "exchange_specific_tiers_margin_and_fees",
    "min_stop_minus_liquidation_atr": 2.0,
    "liquidation_gate_failure": "reduce_leverage_or_skip_never_auto_add_margin",
    "daily_equity_loss_fraction": 0.01,
    "daily_reset_timezone": "UTC",
    "daily_loss_basis": "equity_including_unrealized_pnl_fees_funding_vs_day_start_equity",
    "daily_loss_action": "cancel_pending_flatten_strategy_positions_pause_until_next_UTC_day",
    "consecutive_net_losses_limit": 3,
    "loss_streak_pause_hours": 24,
    "loss_streak_scope": "portfolio_across_symbols",
    "emergency_block_new_entries": ["liquidation_event", "data_feed_loss", "missing_protection", "unavailable_contract_rules"]
  },
  "vision": {
    "variant_id": "D-V",
    "enabled": false,
    "baseline_variant_id": "D-R",
    "role": "filter_only_after_rule_confirmation",
    "image_windows": {"15m": 96, "1h": 96},
    "input_cutoff": "signal_close_latest_closed_bars_only",
    "input_panels": ["candlesticks", "volume"],
    "remove_overlays": ["user_arrows", "trade_labels", "future_bars", "profit_text"],
    "normalization": "per_window_past_only",
    "candidate_architectures": ["ViT_plus_numeric_features", "Swin_plus_numeric_features"],
    "architecture_selected": null,
    "trained_model_version": null,
    "label": "net_pnl_of_fixed_D-R_trade_after_all_costs_positive",
    "calibration": "past_only_heldout_validation",
    "min_calibrated_probability": 0.6,
    "min_expected_net_R_exclusive": 0.0,
    "expected_net_R_estimator": "training_fixed_probability_bin_mean_net_R_validated_then_frozen",
    "required_grounding": "evidence_indices_in_input_and_relations_verified_against_ohlcv",
    "vlm_self_confidence_is_probability": false,
    "missing_model_timeout_or_inconsistent_evidence": "D-V_abstain_no_silent_baseline_fallback",
    "output_fields": ["decision_time", "candidate_id", "model_version", "training_cutoff", "input_hash", "evidence_bar_indices", "structure_label", "p_net_positive_calibrated", "expected_net_R", "grounding_pass", "abstain_reason", "decision"]
  },
  "validation": {
    "backtest_run": false,
    "performance_results": null,
    "minimum_history_months": 24,
    "walk_forward_months": {"train": 12, "validation": 3, "test": 3, "step": 3},
    "final_locked_holdout_months": 3,
    "split": "chronological_synchronized_across_symbols",
    "purge": "remove_samples_whose_feature_start_to_label_exit_span_crosses_boundary",
    "boundary_embargo_bars_15m": 400,
    "random_image_split_allowed": false,
    "slippage_stress_multipliers": [1, 2, 3],
    "one_factor_sensitivity": {"decline_atr_min": [2.0, 2.5, 3.0], "confirmation_bars": [4, 6, 8], "candidate_rvol_min": [1.1, 1.3, 1.5]},
    "acceptance_research_thresholds": {"min_out_of_sample_trades": 200, "net_expectancy_R_gt": 0, "block_bootstrap_95pct_lower_bound_R_gt": 0, "profit_factor_min": 1.2, "max_drawdown_fraction": 0.1, "double_slippage_net_expectancy_gt": 0},
    "paper_trading_min_days": 30,
    "paper_trading_min_trades": 50,
    "vision_incremental_evidence_required": true,
    "metrics": ["trade_count", "win_rate", "net_expectancy_R", "profit_factor", "max_drawdown", "daily_sharpe_365", "capital_exposure", "MAE", "MFE", "tail_loss", "monthly_pnl", "per_symbol_and_regime", "vision_coverage", "Brier_score", "calibration_error"]
  },
