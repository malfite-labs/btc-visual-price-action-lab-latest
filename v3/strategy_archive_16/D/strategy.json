        "future_realized_funding_in_entry_features": false
      },
      "risk": {
        "risk_fraction_per_trade": 0.0025,
        "unit_loss": "E-S*(1-s)+f*(E+S*(1-s))+b*E",
        "quantity": "floor_to_lot(min(equity*0.0025/unit_loss,equity*0.50/E,previous_closed_bar_base_volume*0.005,margin_available_quantity))",
        "max_symbol_notional_fraction": 0.5,
        "max_portfolio_notional_fraction": 1.0,
        "max_order_previous_bar_volume_fraction": 0.005,
        "max_positions": 2,
        "max_portfolio_open_risk_fraction": 0.005,
        "open_risk_definition": "sum_remaining_qty_times_max(entry-current_stop,0)_plus_exit_cost_and_funding_reserve",
