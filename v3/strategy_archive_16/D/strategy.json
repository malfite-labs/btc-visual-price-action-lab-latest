  "rule_sections_zh": {
    "策略定位": "急跌后底部反转，只做多。",
    "适用行情": "15 分钟形态与 1 小时空头和波动过滤。",
    "指标与参数": "15m EMA9/20，1h EMA20/50，Wilder ATR14/RSI14，RVOL20 中位数，收盘位置 CLV。至少 960 根有效 15m 和 240 根完整 1h。",
    "做多规则": "候选及 1–6 根内确认条件见下方完整求值源码和原始规格。WATCH 冻结 ATR、低点、颈线与止损；跌破低点−0.1ATR 失效。",
    "做空规则": "无做空路径。",
    "信号确认": "只在已收盘 K 线确认，下一窗口用合规 ask；检查价差、跳空、结构、数量及独立风控。",
    "止损规则": "初始止损为候选低点−0.25×冻结 ATR。TP1 确认后，下一合格周期按实现提高至至少入场价。",
    "止盈规则": "按确认均价计算 R。TP1 1R 约平一半并按数量步进取整，TP2 2R 平余量。",
    "退出与超时": "报价先检查止损，然后检查未达 TP1 的 8 根和总 16 根超时，再检查目标。风险断路器或清算预警有优先平仓路径。",
    "特殊逻辑": "UTC 日初采用 00:00 对账后可信空仓权益；无基准或数据失效堵新仓。日亏达 1% 锁存并要求清仓，连续三笔已完结亏损暂停 24 小时。现网 D 启用标志关闭，关闭不取消保护。候选取消冷却 4 根，Demo 运行实现从 LONG 恢复空仓时也设 4 根，研究规格另写退出后 8 根。",
    "资金与仓位": "现网 V2 研究初始权益以 8011 返回为准。适用的原风险定仓、杠杆上限、交易所约束及保护保留；估算手续费与实际成交费用分开。 研究规格的 2×逐仓是独立原文，Demo 路径看 DemoDPolicy 和 d_risk。",
    "原始来源与版本": "归档号 D，运行 ID D。8011 版本 D-REBOUND-EMA-RSI-V1，启用 False，当前入场许可 False。\n\n策略库或内置版本证据\n\n\n```json\n{\n  \"kind\": \"standalone_research_specification\",\n  \"version\": \"schema 1.0.0\",\n  \"file\": \"config/strategy_d/D_strategy_15m.json\",\n  \"runtime_diff\": \"研究规格还列 ETHUSDT、2×逐仓、退出冷却8根。当前 Demo 为 BTCUSDT，原执行接线的预检用5×模型，退出冷却见 DemoDPolicy.close。\"\n}\n```\n\n规则校验\n\n\n```json\n{\n  \"method\": \"sha256_of_workspace_sources\",\n  \"verified_local_copy\": true\n}\n```\n\n开仓入口 DemoDRuntime.on_event → DemoDPolicy.close/quote → d_signal.evaluate / d_risk.preflight_entry。\n\n退出入口 DemoDPolicy.protect → d_position_policy.plan_position_event。\n\nPython 策略以代码快照复核。\n\n原始路径和逐文件 SHA-256 见本目录 strategy.json。\n\n8011 状态接口提供策略 ID、版本和启用状态，但未发布整个进程的部署源码摘要。共享执行入口来自工作区源码静态追踪。"
  },
  "rule_payload": {
    "original_research_specification": {
      "schema_version": "1.0.0",
      "strategy_id": "D_15M_BOTTOM_REVERSAL",
      "name_zh": "D策略：15分钟急跌后底部反转",
      "as_of": "2026-11-05",
      "status": "research_specification_unbacktested",
      "format": "custom_specification_not_platform_import_or_executable_code",
      "specification_file": "D策略_完整说明.md",
      "live_enabled": false,
      "scope": {
        "market": "crypto_perpetual",
        "contract_type": "USDT_linear",
        "exchange": null,
        "exchange_required_before_live": true,
        "symbols_research": [
          "BTCUSDT",
          "ETHUSDT"
        ],
        "direction": "long_only",
        "margin_mode": "isolated",
        "max_leverage": 2,
        "auto_add_margin": false,
        "signal_timeframe": "15m",
        "context_timeframe": "1h",
        "data_timezone": "UTC",
        "report_timezone": "Asia/Shanghai"
      },
      "data": {
        "ohlcv_source": "same_exchange_perpetual_trade_prices",
        "volume_unit": "base_asset",
        "required_auxiliary": [
          "mark_prices",
          "funding_rates_and_settlement_times",
          "contract_filters",
          "bid_ask_quotes"
        ],
        "execution_preferred": "1m_or_tick",
        "warmup_bars_15m": 960,
        "warmup_bars_1h": 240,
        "closed_bars_only": true,
        "one_hour_alignment": "latest_fully_closed_UTC_hour",
        "invalid_data_action": "block_new_entries_keep_protection_require_contiguous_rewarmup",
        "invalid_conditions": [
          "missing",
          "duplicate",
          "out_of_order",
          "invalid_ohlc",
          "volume_nonpositive",
          "nonfinite_indicator"
        ],
        "range_notation": "inclusive_start_and_end"
      },
      "indicators": {
        "ema_periods_15m": [
          9,
          20
        ],
        "ema_periods_1h": [
          20,
          50
        ],
        "ema_seed": "SMA_first_n_closes_then_alpha_2_over_n_plus_1",
        "atr_period": 14,
        "atr_method": "Wilder_RMA_seed_mean_first_14_true_ranges",
        "rsi_period": 14,
        "rsi_method": "Wilder_RMA",
        "rsi_zero_loss_value": 100,
        "rsi_both_zero_value": 50,
        "rvol_lookback": 20,
        "rvol_definition": "V[t]/median(V[t-20:t-1])",
        "clv_definition": "(C-L)/(H-L)",
        "lower_wick_definition": "(min(O,C)-L)/(H-L)",
        "zero_range_action": "reject_candidate_or_confirmation"
      },
      "state_machine": {
        "states": [
          "IDLE",
          "WATCH",
          "PENDING",
          "LONG",
          "COOLDOWN"
        ],
        "priority": [
          "position_risk_and_exits",
          "cooldown",
          "candidate_invalidation",
          "confirmation",
          "new_candidate"
        ],
        "same_bar_create_and_confirm": false,
        "same_bar_recreate_after_invalidation": false,
        "replace_active_candidate": false,
        "max_entries_per_candidate": 1,
        "max_positions_per_symbol": 1,
        "pyramiding": false,
        "averaging_down": false,
        "simultaneous_symbol_priority": [
          "BTCUSDT",
          "ETHUSDT"
        ],
        "cooldown_after_cancel_bars": 4,
        "cooldown_after_exit_bars": 8,
        "cooldown_count": "subsequent_full_15m_bars"
      },
      "candidate": {
        "evaluation": "at_k_close_only_when_IDLE",
        "all_conditions": [
          "C[k-1]<EMA20[k-1]",
          "EMA20[k-1]<EMA20[k-5]",
          "A=ATR14[k-1]>0",
          "(max(H[k-12:k-1])-L[k])/A>=2.5",
          "L[k]<min(L[k-8:k-1])",
          "C[k]>O[k] OR lower_wick_ratio[k]>=0.35",
          "CLV[k]>=0.55",
          "RVOL[k]>=1.3"
        ],
        "frozen_values": {
          "A": "ATR14[k-1]",
          "L0": "L[k]",
          "N": "max(H[k-3:k-1])",
          "S_raw": "L0-0.25*A"
        },
        "decline_lookback": 12,
        "decline_atr_min": 2.5,
        "new_low_lookback": 8,
        "lower_wick_ratio_min": 0.35,
        "clv_min": 0.55,
        "rvol_min": 1.3,
        "neckline_lookback": 3,
        "stop_buffer_atr": 0.25,
        "invalidation": "L[t]<L0-0.10*A",
        "invalidation_buffer_atr": 0.1,
        "confirmation_first_offset": 1,
        "confirmation_last_offset": 6,
        "expiry_order": "at_k_plus_6_invalidate_then_attempt_confirm_then_expire"
      },
      "confirmation": {
        "all_conditions": [
          "C[t]>N+0.05*A",
          "C[t]>EMA9[t]",
          "C[t]>O[t]",
          "CLV[t]>=0.65",
          "RVOL[t]>=1.2",
          "RSI14[t]>RSI14[t-1] AND RSI14[t]>=35",
          "0<C[t]-L0<=3.5*A",
          "NOT(C1h[h]<EMA50_1h[h] AND EMA20_1h[h]<EMA20_1h[h-3])",
          "0.6*A<=C[t]-S<=3.0*A",
          "ATR14_1h[h]/C1h[h]<=0.04"
        ],
        "breakout_buffer_atr": 0.05,
        "clv_min": 0.65,
        "rvol_min": 1.2,
        "rsi_min": 35,
        "max_distance_from_low_atr": 3.5,
        "max_hourly_atr_fraction": 0.04,
        "signal": "D_CONFIRM"
      },
      "entry": {
        "timing": "next_15m_bar_open_once",
        "order_type": "market",
        "reference_price_G": "O[t+1]_backtest_or_executable_ask_live",
        "modeled_fill_E": "G*(1+slippage_fraction)",
        "max_abs_gap_atr": 0.3,
        "all_conditions": [
          "abs(G-C[t])<=0.30*A",
          "G>N",
          "G>S",
          "0<E-L0<=3.5*A",
          "0.6*A<=E-S<=3.0*A",
          "(E-S)/E<=0.02",
          "spread_fraction<=0.0005",
          "all_portfolio_margin_liquidation_and_contract_filters_pass"
        ],
        "min_stop_distance_atr": 0.6,
        "max_stop_distance_atr": 3.0,
        "max_stop_distance_fraction": 0.02,
        "max_spread_fraction": 0.0005,
        "missing_quote_live": "reject",
        "missing_quote_research": "disclose_execution_unverified",
        "failed_gate_action": "cancel_and_cooldown_no_delayed_entry",
        "after_fill": "recompute_actual_risk_reduce_if_excess_exit_and_pause_if_protection_fails"
      },
      "exits": {
        "R_definition": "actual_entry_E_minus_tick_rounded_initial_S",
        "initial_stop": "floor_to_tick(L0-0.25*A)",
        "stop_trigger": "last_trade_price",
        "liquidation_monitor": "independent_mark_price",
        "reduce_only": true,
        "take_profits": [
          {
            "r_multiple": 1.0,
            "fraction_initial_quantity": 0.5
          },
          {
            "r_multiple": 2.0,
            "fraction_initial_quantity": 0.5
          }
        ],
        "take_profit_rounding": "ceil_to_tick",
        "take_profit_execution": "trigger_then_market_with_sell_slippage_and_taker_fee",
        "after_tp1_stop": "max(previous_stop,E)_effective_next_15m_bar",
        "breakeven_is_price_only_not_fee_adjusted": true,
        "no_tp1_time_stop_bars": 8,
        "max_holding_bars": 16,
        "entry_bar_counts_as": 1,
        "time_exit": "next_open_after_counted_bar_closes",
        "time_exit_priority": "gap_stop_first_then_scheduled_exit_before_new_signals",
        "stop_gap_fill": "min(stop,bar_open)*(1-slippage_fraction)",
        "same_bar_stop_and_target": "stop_first_if_no_lower_timeframe_path",
        "same_bar_both_targets_only": "tp1_then_tp2",
        "illegal_split_quantity": "reject_before_entry"
      },
      "costs": {
        "status": "illustrative_replace_with_actual_account_and_execution_data",
        "taker_fee_fraction_per_side": 0.0005,
        "slippage_fraction_per_side": 0.0003,
        "funding_risk_reserve_fraction": 0.0005,
        "funding_pnl": "-remaining_base_quantity*settlement_mark_price*actual_funding_rate",
